<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package identity and listing metadata. PackageId/AssemblyName default to
         the project filename (Kookerella.FsWordDsl), so they're intentionally not
         overridden here. Version is a plain field to bump by hand per release - there's
         no CI/release pipeline driving it yet (see CLAUDE.md: this repo currently ships
         the F# core only). -->
    <Version>0.1.0</Version>
    <Authors>Kookerella</Authors>
    <Company>Kookerella Ltd</Company>
    <Description>A typesafe F# DSL for building and reading Word documents (.docx/.dotm), interpreted into calls against the DocumentFormat.OpenXml SDK. Unlike write-only Word generators, this round-trips and can decompile an existing file into equivalent, runnable F# source (Document.generateScript), plain XML against a real embedded schema (Xml.ofDocument/Xml.toDocument, Xml.xsd), or plain JSON (Json.ofDocument/Json.toDocument) - read a real document, get back the code or data that rebuilds it. Covers paragraphs and runs (rich, independently-styled text), named styles, numbered/bulleted lists, tables, images, hyperlinks, bookmarks, comments, sections and page setup, headers/footers, document protection, and VBA macro embedding.</Description>
    <PackageTags>fsharp;word;docx;dotm;openxml;wordprocessingml;dsl;code-generation;round-trip</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/Kookerella-Ltd/Kookerella.FsWordDsl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kookerella-Ltd/Kookerella.FsWordDsl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packs the repo-root README/LICENSE into the .nupkg so they render on the NuGet
         gallery page and satisfy PackageReadmeFile above - PackagePath="/" puts them at
         the package root rather than nested under this project's own folder. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Units.fs" />
    <Compile Include="Styles.fs" />
    <Compile Include="NamedStyles.fs" />
    <Compile Include="Numbering.fs" />
    <Compile Include="Hyperlinks.fs" />
    <Compile Include="Protection.fs" />
    <Compile Include="Revisions.fs" />
    <Compile Include="ContentControls.fs" />
    <Compile Include="PageSetup.fs" />
    <Compile Include="Tables.fs" />
    <Compile Include="Images.fs" />
    <Compile Include="DocumentProperties.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Xml.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Builders.fs" />
    <Compile Include="Interpreter\StyleRegistry.fs" />
    <Compile Include="Interpreter\ImageWriter.fs" />
    <Compile Include="Interpreter\ImageReader.fs" />
    <Compile Include="Interpreter\Writer.fs" />
    <Compile Include="Interpreter\Reader.fs" />
    <Compile Include="Interpreter\CodeGen.fs" />
    <Compile Include="Api.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded (not just a loose repo file) so `Xml.schemaSet()` works for a consumer of
         the published package too, who has no repo checkout to read a physical path from. -->
    <EmbeddedResource Include="Xml.xsd">
      <LogicalName>Kookerella.FsWordDsl.Xml.xsd</LogicalName>
    </EmbeddedResource>
    <!-- Deliberately NOT embedded and NOT packed, unlike Xml.xsd - Json's schema validation
         is test-suite only, same reasoning as the Excel repo's Json.fs. Listed explicitly so
         Solution Explorer shows it; F#'s SDK doesn't auto-include files the way C#'s does. -->
    <None Include="Json.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
