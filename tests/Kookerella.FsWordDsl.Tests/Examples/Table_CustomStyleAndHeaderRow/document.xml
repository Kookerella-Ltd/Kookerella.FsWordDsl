<?xml version="1.0" encoding="utf-8"?>
<document>
  <sections>
    <section>
      <pageSetup orientation="Portrait" columns="1" breakType="NextPageBreak">
        <pageSize kind="Letter" />
        <margins top="72" bottom="72" left="72" right="72" header="36" footer="36" gutter="0" />
      </pageSetup>
      <body>
        <table>
          <tableStyle name="MyTableStyle" />
          <cellMargins top="4" bottom="4" left="6" right="6" />
          <columnWidths>
            <col width="200" />
            <col width="150" />
          </columnWidths>
          <rows>
            <row height="20" repeatAsHeader="true">
              <cell>
                <cellProps width="200" />
                <para>
                  <run>Name</run>
                </para>
              </cell>
              <cell>
                <cellProps width="150">
                  <cellMargins top="2" bottom="2" left="8" right="8" />
                </cellProps>
                <para>
                  <run>Amount</run>
                </para>
              </cell>
            </row>
            <row>
              <cell>
                <cellProps width="200" />
                <para>
                  <run>Widgets</run>
                </para>
              </cell>
              <cell>
                <cellProps width="150" />
                <para>
                  <run>12</run>
                </para>
              </cell>
            </row>
            <row>
              <cell>
                <cellProps width="200" />
                <para>
                  <run>Gadgets</run>
                </para>
              </cell>
              <cell>
                <cellProps width="150" />
                <para>
                  <run>7</run>
                </para>
              </cell>
            </row>
          </rows>
        </table>
      </body>
    </section>
  </sections>
  <styles>
    <style id="Normal" name="Normal" type="paragraph">
      <runStyle fontFamily="Calibri" size="11" />
    </style>
    <style id="Heading1" name="heading 1" type="paragraph" basedOn="Normal">
      <runStyle size="16" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="12" spacingAfter="6" keepWithNext="true" />
    </style>
    <style id="Heading2" name="heading 2" type="paragraph" basedOn="Normal">
      <runStyle size="14" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="10" spacingAfter="4" keepWithNext="true" />
    </style>
    <style id="Heading3" name="heading 3" type="paragraph" basedOn="Normal">
      <runStyle size="13" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="8" spacingAfter="4" keepWithNext="true" />
    </style>
    <style id="Title" name="Title" type="paragraph" basedOn="Normal">
      <runStyle size="28" bold="true" />
      <paragraphFormat spacingAfter="12" />
    </style>
    <style id="ListParagraph" name="List Paragraph" type="paragraph" basedOn="Normal">
      <paragraphFormat>
        <indentation left="36" />
      </paragraphFormat>
    </style>
    <style id="Hyperlink" name="Hyperlink" type="character">
      <runStyle underline="single" color="0563C1" />
    </style>
    <style id="FootnoteReference" name="footnote reference" type="character">
      <runStyle verticalPosition="superscript" />
    </style>
    <style id="EndnoteReference" name="endnote reference" type="character">
      <runStyle verticalPosition="superscript" />
    </style>
    <style id="FootnoteText" name="footnote text" type="paragraph" basedOn="Normal">
      <runStyle size="10" />
    </style>
    <style id="EndnoteText" name="endnote text" type="paragraph" basedOn="Normal">
      <runStyle size="10" />
    </style>
  </styles>
  <tableStyles>
    <tableStyleDef id="MyTableStyle" name="My Table Style">
      <tableBorders>
        <left style="single" width="0.5" color="000000" />
        <right style="single" width="0.5" color="000000" />
        <top style="single" width="0.5" color="000000" />
        <bottom style="single" width="0.5" color="000000" />
        <insideHorizontal style="single" width="0.5" color="000000" />
        <insideVertical style="single" width="0.5" color="000000" />
      </tableBorders>
      <firstRow cellShading="4F81BD">
        <runStyle bold="true" color="FFFFFF" />
      </firstRow>
      <lastRow>
        <runStyle italic="true" />
      </lastRow>
      <firstColumn>
        <runStyle bold="true" />
      </firstColumn>
      <bandedRow cellShading="DCE6F1" />
      <bandedColumn cellShading="F2F2F2" />
      <northWestCell cellShading="2D5082" />
    </tableStyleDef>
  </tableStyles>
</document>