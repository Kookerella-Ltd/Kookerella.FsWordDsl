<?xml version="1.0" encoding="utf-8"?>
<document>
  <sections>
    <section>
      <pageSetup orientation="Portrait" columns="1" breakType="NextPageBreak">
        <pageSize kind="Letter" />
        <margins top="72" bottom="72" left="72" right="72" header="36" footer="36" gutter="0" />
      </pageSetup>
      <body>
        <table>
          <columnWidths>
            <col width="150" />
            <col width="150" />
          </columnWidths>
          <rows>
            <row>
              <cell>
                <cellProps gridSpan="2" width="150" />
                <para>
                  <run>
                    <runStyle bold="true" />Spans 2 columns</run>
                </para>
              </cell>
            </row>
            <row>
              <cell>
                <cellProps width="150" />
                <para>
                  <run>A1</run>
                </para>
              </cell>
              <cell>
                <cellProps verticalMerge="restart" width="150" />
                <para>
                  <run>B1 (merged down)</run>
                </para>
              </cell>
            </row>
            <row>
              <cell>
                <cellProps width="150" />
                <para>
                  <run>A2</run>
                </para>
              </cell>
              <cell>
                <cellProps verticalMerge="continue" width="150" />
                <para />
              </cell>
            </row>
          </rows>
        </table>
      </body>
    </section>
  </sections>
  <styles>
    <style id="Normal" name="Normal" type="paragraph">
      <runStyle fontFamily="Calibri" size="11" />
    </style>
    <style id="Heading1" name="heading 1" type="paragraph" basedOn="Normal">
      <runStyle size="16" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="12" spacingAfter="6" keepWithNext="true" />
    </style>
    <style id="Heading2" name="heading 2" type="paragraph" basedOn="Normal">
      <runStyle size="14" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="10" spacingAfter="4" keepWithNext="true" />
    </style>
    <style id="Heading3" name="heading 3" type="paragraph" basedOn="Normal">
      <runStyle size="13" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="8" spacingAfter="4" keepWithNext="true" />
    </style>
    <style id="Title" name="Title" type="paragraph" basedOn="Normal">
      <runStyle size="28" bold="true" />
      <paragraphFormat spacingAfter="12" />
    </style>
    <style id="ListParagraph" name="List Paragraph" type="paragraph" basedOn="Normal">
      <paragraphFormat>
        <indentation left="36" />
      </paragraphFormat>
    </style>
    <style id="Hyperlink" name="Hyperlink" type="character">
      <runStyle underline="single" color="0563C1" />
    </style>
    <style id="FootnoteReference" name="footnote reference" type="character">
      <runStyle verticalPosition="superscript" />
    </style>
    <style id="EndnoteReference" name="endnote reference" type="character">
      <runStyle verticalPosition="superscript" />
    </style>
    <style id="FootnoteText" name="footnote text" type="paragraph" basedOn="Normal">
      <runStyle size="10" />
    </style>
    <style id="EndnoteText" name="endnote text" type="paragraph" basedOn="Normal">
      <runStyle size="10" />
    </style>
  </styles>
</document>