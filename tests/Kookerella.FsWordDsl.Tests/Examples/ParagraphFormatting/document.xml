<?xml version="1.0" encoding="utf-8"?>
<document>
  <sections>
    <section>
      <pageSetup orientation="Portrait" columns="1">
        <pageSize kind="Letter" />
        <margins top="72" bottom="72" left="72" right="72" header="36" footer="36" gutter="0" />
      </pageSetup>
      <body>
        <para>
          <paragraphFormat alignment="center" spacingBefore="12" spacingAfter="12" />
          <run>Centered heading-like text.</run>
        </para>
        <para>
          <paragraphFormat>
            <lineSpacing kind="double" />
            <indentation left="36" />
          </paragraphFormat>
          <run>An indented, double-spaced paragraph.</run>
        </para>
      </body>
    </section>
  </sections>
  <styles>
    <style id="Normal" name="Normal" type="paragraph">
      <runStyle fontFamily="Calibri" size="11" />
    </style>
    <style id="Heading1" name="heading 1" type="paragraph" basedOn="Normal">
      <runStyle size="16" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="12" spacingAfter="6" keepWithNext="true" />
    </style>
    <style id="Heading2" name="heading 2" type="paragraph" basedOn="Normal">
      <runStyle size="14" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="10" spacingAfter="4" keepWithNext="true" />
    </style>
    <style id="Heading3" name="heading 3" type="paragraph" basedOn="Normal">
      <runStyle size="13" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="8" spacingAfter="4" keepWithNext="true" />
    </style>
    <style id="Title" name="Title" type="paragraph" basedOn="Normal">
      <runStyle size="28" bold="true" />
      <paragraphFormat spacingAfter="12" />
    </style>
    <style id="ListParagraph" name="List Paragraph" type="paragraph" basedOn="Normal">
      <paragraphFormat>
        <indentation left="36" />
      </paragraphFormat>
    </style>
    <style id="Hyperlink" name="Hyperlink" type="character">
      <runStyle underline="single" color="0563C1" />
    </style>
  </styles>
</document>