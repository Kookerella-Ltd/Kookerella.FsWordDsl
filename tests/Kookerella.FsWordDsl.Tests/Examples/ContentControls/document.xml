<?xml version="1.0" encoding="utf-8"?>
<document>
  <sections>
    <section>
      <pageSetup orientation="Portrait" columns="1" breakType="NextPageBreak">
        <pageSize kind="Letter" />
        <margins top="72" bottom="72" left="72" right="72" header="36" footer="36" gutter="0" />
      </pageSetup>
      <body>
        <para>
          <run>Client name: </run>
          <contentControl alias="Client Name" tag="clientName">
            <plainText />
            <content>
              <run>Type here</run>
            </content>
          </contentControl>
          <run>.</run>
        </para>
        <para>
          <run>Favorite color: </run>
          <contentControl alias="Favorite Color">
            <dropDown>
              <item displayText="Red" value="red" />
              <item displayText="Green" value="green" />
              <item displayText="Blue" value="blue" />
            </dropDown>
            <content>
              <run>Blue</run>
            </content>
          </contentControl>
        </para>
        <para>
          <run>Feedback: </run>
          <contentControl tag="feedbackChoice">
            <dropDown editable="true">
              <item displayText="Yes" value="yes" />
              <item displayText="No" value="no" />
              <item displayText="Other" value="other" />
            </dropDown>
            <content>
              <run>Other</run>
            </content>
          </contentControl>
        </para>
        <para>
          <run>Meeting date: </run>
          <contentControl alias="Meeting Date" lock="lockContentEditing">
            <date fullDate="2024-03-01T00:00:00.0000000" format="MMMM d, yyyy" />
            <content>
              <run>March 1, 2024</run>
            </content>
          </contentControl>
        </para>
        <para>
          <run>Agreed: </run>
          <contentControl tag="agreed" lock="lockDeletionAndContentEditing">
            <checkBox checked="true" checkedFont="Wingdings" checkedCode="2612" uncheckedFont="Wingdings" uncheckedCode="2610" />
            <content>
              <run>☑</run>
            </content>
          </contentControl>
        </para>
        <contentControlBlock alias="Notes">
          <richText />
          <content>
            <para>
              <run>This whole paragraph is a rich-text content control.</run>
            </para>
          </content>
        </contentControlBlock>
      </body>
    </section>
  </sections>
  <styles>
    <style id="EndnoteReference" name="endnote reference" type="character">
      <runStyle verticalPosition="superscript" />
    </style>
    <style id="EndnoteText" name="endnote text" type="paragraph" basedOn="Normal">
      <runStyle size="10" />
    </style>
    <style id="FootnoteReference" name="footnote reference" type="character">
      <runStyle verticalPosition="superscript" />
    </style>
    <style id="FootnoteText" name="footnote text" type="paragraph" basedOn="Normal">
      <runStyle size="10" />
    </style>
    <style id="Heading1" name="heading 1" type="paragraph" basedOn="Normal">
      <runStyle size="16" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="12" spacingAfter="6" keepWithNext="true" />
    </style>
    <style id="Heading2" name="heading 2" type="paragraph" basedOn="Normal">
      <runStyle size="14" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="10" spacingAfter="4" keepWithNext="true" />
    </style>
    <style id="Heading3" name="heading 3" type="paragraph" basedOn="Normal">
      <runStyle size="13" bold="true" color="2F5496" />
      <paragraphFormat spacingBefore="8" spacingAfter="4" keepWithNext="true" />
    </style>
    <style id="Hyperlink" name="Hyperlink" type="character">
      <runStyle underline="single" color="0563C1" />
    </style>
    <style id="ListParagraph" name="List Paragraph" type="paragraph" basedOn="Normal">
      <paragraphFormat>
        <indentation left="36" />
      </paragraphFormat>
    </style>
    <style id="Normal" name="Normal" type="paragraph">
      <runStyle fontFamily="Calibri" size="11" />
    </style>
    <style id="Title" name="Title" type="paragraph" basedOn="Normal">
      <runStyle size="28" bold="true" />
      <paragraphFormat spacingAfter="12" />
    </style>
  </styles>
</document>