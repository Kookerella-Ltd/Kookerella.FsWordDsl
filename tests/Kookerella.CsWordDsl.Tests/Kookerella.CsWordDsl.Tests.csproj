<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- DocumentFormat.OpenXml is a direct dependency here purely for this test suite's own
         schema-validation helper (OpenXmlValidator) - a real consumer of the wrapper
         wouldn't need it, the same way the F# test project's own use of it is test-only. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses the F# test suite's own already-built .docx fixtures (see ExampleTests.cs)
         rather than re-authoring every scenario from scratch - one real example beats two
         copies drifting apart. -->
    <None Include="..\Kookerella.FsWordDsl.Tests\Examples\**\output.docx" Link="Examples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Kookerella.FsWordDsl.Tests\Examples\**\output.docm" Link="Examples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kookerella.CsWordDsl\Kookerella.CsWordDsl.csproj" />
  </ItemGroup>

</Project>
